STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
BASE_URL=http://localhost:3002
PORT=3002

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Admin notification recipients
ADMIN_EMAIL_1=owner@example.com
ADMIN_EMAIL_2=assistant@example.com

# Admin dashboard password — use a strong random string
ADMIN_PASSWORD=change_me_to_something_strong

# Sentry error monitoring (optional — leave blank to disable)
# Get DSN from sentry.io
SENTRY_DSN=

# Upstash Redis (leave blank for local dev — falls back to bookings.json)
# Get these from upstash.com or Vercel Storage > Redis integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cal.com integration (leave blank to keep using mocked calendar)
# Get API key from cal.com > Settings > Security
CALCOM_API_KEY=
# Cal.com username (your cal.com account username)
CALCOM_USERNAME=
# Event type IDs from cal.com > Event Types (click each event type to find its ID)
CALCOM_EVENT_TYPE_VIDEO=0
CALCOM_EVENT_TYPE_INHOME=0

# Referral coupon amounts (in cents, e.g. 2500 = $25.00)
# These are auto-emailed to referrers and new clients when a referral books
REFERRAL_CREDIT_AMOUNT=2500
REFERRAL_WELCOME_AMOUNT=1000
